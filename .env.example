# Copy this file to .env and fill in your values.
# Never commit .env to git.

# --- OpenAI ---
OPENAI_API_KEY=your-openai-api-key-here

# --- PostgreSQL + pgvector ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ragdb
POSTGRES_USER=raguser
POSTGRES_PASSWORD=your-password-here

# Assembled connection string — used by LangChain and psycopg
DATABASE_URL=postgresql+psycopg://raguser:your-password-here@localhost:5432/ragdb
